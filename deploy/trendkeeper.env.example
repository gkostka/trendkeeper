# Copy to /etc/trendkeeper.env, fill in, then: chown trendkeeper: /etc/trendkeeper.env && chmod 600 /etc/trendkeeper.env
# Never commit the real file.
TK_CONFIG=/var/lib/trendkeeper/config.toml
TK_SLACK_WEBHOOK=https://hooks.slack.com/services/...
TK_SMTP_HOST=smtp.gmail.com
TK_SMTP_PORT=587
TK_SMTP_USER=you@example.com
TK_SMTP_PASSWORD=app-password-not-your-login
TK_HEALTHCHECK_DAILY=https://hc-ping.com/your-check-uuid
TK_BACKUP_DIR=/mnt/backup/trendkeeper
# TK_BACKUP_SCP=nas:/backups/trendkeeper/
