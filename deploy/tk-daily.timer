[Unit]
Description=Trendkeeper daily run, after the US close and before midnight in Europe

[Timer]
# 75 minutes after the US close, and 45 before midnight in Berlin (1 h 45 in the weeks the US and Europe switch
# clocks apart): after midnight Yahoo drops the day's row for DBPG, LQQ and SXRM until its final bar, a day later.
OnCalendar=Mon..Fri 17:15 America/New_York
# A run missed while the device was off or rebooting starts as soon as it is back.
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
